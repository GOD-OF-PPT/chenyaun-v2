{
  "name": "chenyuan-wendao-v2",
  "version": "2.0.0",
  "private": true,
  "description": "《尘缘问道 · 剑阵万象》2.5D 动作修仙网页游戏与自动化验收工具链",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test:regression": "node scripts/verify-playable-v2.mjs",
    "test:e2e": "node tests/e2e/run.mjs",
    "art:manifest": "node scripts/art-manifest.mjs",
    "art:manifest:check": "node scripts/art-manifest.mjs --check",
    "security:scan": "node scripts/scan-static-web.mjs",
    "security:test": "node --test tests/static-security.test.mjs",
    "security:smoke": "node scripts/verify-static-security.mjs",
    "vendor:update": "node scripts/vendor-dompurify.mjs",
    "vendor:check": "node scripts/vendor-dompurify.mjs --check",
    "build:static": "npm run vendor:check && python3 scripts/package-static.py"
  },
  "devDependencies": {
    "acorn": "8.19.0",
    "dompurify": "3.5.0",
    "playwright-core": "1.65.1"
  }
}
